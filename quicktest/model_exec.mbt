// ========================================
// Model Exec - 纯模型执行器 — Generated by QuickMachine Code Generator
// FSM: moongard_family_ledger | Config: moongard_family_conservation
// Generated at: 1793500000000
// 默认实现"可运行但保守"；人工补充点以 TODO(P0)-TODO(P5) 标记
// 手维护实例（.hand-maintained 在案）:P0——臂体扩 jti 链推进（Rotate 代际
// +1 换票，ReplayOld 只翻 Dead 不动链，Forge 零账面）。
// ========================================
// model_execute 是规格（specification），不是被测实现：
// 臂结构与 [[transitions]] 一一对应；纯模型与真实执行器语义漂移由属性测试双执行比较兜底

///|
/// 纯模型执行: (Model, Command) -> (Model, Response)
/// 兜底 (_, _) => Error(0) 为非法转移
fn model_execute(model : Model, cmd : Command) -> (Model, Response) {
  match (model.state, cmd) {
    // --- Fresh ---
    // @arm Fresh+Seed
    (Fresh, Seed) =>
      (
        { state: Alive, generation: 0, current_jti: "g0", prev_jti: None, },
        Continue,
      )
    // --- Alive ---
    // @arm Alive+Rotate
    (Alive, Rotate) =>
      (
        {
          state: Alive,
          generation: model.generation + 1,
          current_jti: "g\{model.generation + 1}",
          prev_jti: Some(model.current_jti),
        },
        Continue,
      )
    // @arm Alive+ReplayOld
    (Alive, ReplayOld) => ({ ..model, state: Dead, }, Continue)
    // @arm Alive+Forge
    (Alive, Forge) => (model, Continue)
    // --- Dead ---
    // @arm Dead+Forge
    (Dead, Forge) => (model, Continue)
    // 兜底: 非法转移（valid 已过滤, 防御性保留）
    (_, _) => (model, Error(0))
  }
}

///|
/// 模型推进（quickcheck_statemachine transition_symbolic/concrete 接口形态）
/// 非法/错误响应不推进模型
fn transition(model : Model, command : Command, response : Response) -> Model {
  match response {
    Error(_) => model
    _ => model_execute(model, command).0
  }
}

///|
test "moongard_family_conservation model_exec: 非法转移兜底 / transition 不推进" {
  // 非法转移兜底 + transition: 错误响应不推进
  let m = model_empty()
  let (m_bad, resp_bad) = model_execute(m, Rotate)
  assert_eq(resp_bad, Error(0))
  assert_eq(m_bad, m)
  let t_err = transition(m, Rotate, Error(0))
  assert_eq(t_err, m)
  // transition: 正常推进
  let t_ok = transition(m, Seed, Continue)
  assert_true(t_ok != m)
}
