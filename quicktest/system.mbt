///|
/// 确定性符号器:sign=透传,verify=逐字节等（守恒机不测密码学,只测账本;
/// D-G2 时间与熵全注入,确定性可复现）
priv enum StubSigner {
  Stub
}

///|
impl @moongard.Signer for StubSigner with fn sign(
  self : StubSigner,
  payload : Bytes,
) -> Bytes {
  ignore(self)
  payload
}

///|
impl @moongard.Signer for StubSigner with fn verify(
  self : StubSigner,
  payload : Bytes,
  mac : Bytes,
) -> Bool {
  ignore(self)
  payload == mac
}

///|
/// StubSigner 单例（tag 仅为字段消歧,无语义）
fn stub_signer() -> StubSigner {
  Stub
}

///|
/// 固定配置:issuer/audience 钉死,TTL 远大于固定时钟（v1 不走 Expired 分支）
fn machine_config() -> @moongard.GuardConfig {
  @moongard.GuardConfig::make(
    issuer="quicktest.mg",
    audience="family-ledger",
    access_ttl_ms=60000L,
    refresh_ttl_ms=600000L,
  )
}

///|
/// 固定时钟（D-G2:时间注入;TTL 600s 内不过期）
const MACHINE_NOW : Int64 = 1000000L

///|
/// System: 被测系统 = MemRefreshStore 族谱真值 + 代际链游标
priv struct System {
  store : @memstore.MemRefreshStore // 账本只原地改内容,不整体重赋（[0015] 律）
  mut family : String
  mut current_token : String
  mut current_jti : String
  mut prev_token : String?
  mut generation : Int32
  mut dead : Bool
}

///|
fn system_init() -> System {
  {
    store: @memstore.MemRefreshStore::new(),
    family: "",
    current_token: "",
    current_jti: "",
    prev_token: None,
    generation: 0,
    dead: false,
  }
}

///|
/// 族内记录遍历（账本真值面;按 family_id 过滤）
fn family_records(system : System) -> Array[@moongard.RefreshRecord] {
  let found : Array[@moongard.RefreshRecord] = []
  for _jti, record in system.store.table {
    if record.family_id == system.family {
      found.push(record)
    }
  }
  found
}

///|
/// 守恒律扫账四验（本机的被测性质;每步全过）:
/// ① 链长守恒——族内记录数 == 代际 + 1（Seed 一张,每代换发恰好添一张）
/// ② used 数守恒——族内 used=true 数 == 代际（每代 mark_used 恰好一张）
/// ③ 死族全撤——dead 后族内每条 revoked=true（D-G3 revoke_family 语义）
/// ④ 伪造不动账——UnknownToken 零增删（定点验于 Forge 步,不在此扫）
/// 违律 → Error(1)
fn conserve_verify(system : System) -> Response {
  let records = family_records(system)
  if records.length() != system.generation + 1 {
    return Error(1)
  }
  let mut used_count = 0
  let mut revoked_count = 0
  for record in records {
    if record.used {
      used_count = used_count + 1
    }
    if record.revoked {
      revoked_count = revoked_count + 1
    }
  }
  if used_count != system.generation {
    return Error(1)
  }
  if system.dead && revoked_count != records.length() {
    return Error(1)
  }
  Continue
}

///|
/// 真实执行: Command → 旋转核过账 → 扫账四验 → Response（守恒律即后置条件）
/// 核返回与语义预期不符 → Error(2)（语义漂移）;守恒破 → Error(1)
fn run_command(command : Command, system : System) -> Response {
  match command {
    Seed => {
      let issued = @moongard.issue(
        machine_config(),
        stub_signer(),
        MACHINE_NOW,
        "alice",
        @moongard.TokenType::Refresh,
        "g0",
      )
      system.store.put("g0", {
        family_id: "fam0",
        sub: "alice",
        issued_at: MACHINE_NOW,
        expires_at: issued.claims.exp,
        used: false,
        revoked: false,
      })
      system.family = "fam0"
      system.current_token = issued.token
      system.current_jti = "g0"
      system.prev_token = None
      system.generation = 0
      system.dead = false
      conserve_verify(system)
    }
    Rotate =>
      match
        @moongard.refresh(
          machine_config(),
          stub_signer(),
          system.store,
          MACHINE_NOW,
          system.current_token,
          "g\{system.generation + 1}",
        ) {
        Ok(refreshed) => {
          system.prev_token = Some(system.current_token)
          system.current_token = refreshed.refresh.token
          system.current_jti = refreshed.refresh.claims.jti
          system.generation = system.generation + 1
          conserve_verify(system)
        }
        Err(_) => Error(2)
      }
    ReplayOld =>
      match system.prev_token {
        Some(old_token) =>
          match
            @moongard.refresh(
              machine_config(),
              stub_signer(),
              system.store,
              MACHINE_NOW,
              old_token,
              "g-ghost",
            ) {
            Err(Replayed(_family)) => {
              system.dead = true
              conserve_verify(system)
            }
            _ => Error(2) // 重放必 Replayed——其余返回皆语义漂移
          }
        None => Error(0) // 无上代票（valid 已挡,防御性归一）
      }
    Forge => {
      let ghost = @moongard.issue(
        machine_config(),
        stub_signer(),
        MACHINE_NOW,
        "mallory",
        @moongard.TokenType::Refresh,
        "g-ghost",
      )
      let before = family_records(system).length()
      let verdict = @moongard.refresh(
        machine_config(),
        stub_signer(),
        system.store,
        MACHINE_NOW,
        ghost.token,
        "g-ghost-child",
      )
      let after = family_records(system).length()
      match verdict {
        Err(UnknownToken) =>
          if before == after && system.store.get("g-ghost") is None {
            conserve_verify(system) // 律④:伪造不动账,账面零增删
          } else {
            Error(1)
          }
        _ => Error(2) // 伪造必 UnknownToken——其余返回皆语义漂移
      }
    }
  }
}

// ===== 守恒律测试（固定基线; 随机交错由 runner 的 qcs 门承担） =====

///|
test "moongard 守恒律: Seed 基线——链长 1 / used 0, 扫账绿" {
  let system = system_init()
  assert_eq(run_command(Seed, system), Continue)
  assert_eq(system.generation, 0)
  assert_eq(family_records(system).length(), 1)
}

///|
test "moongard 守恒律: 双 Rotate——链长 3 / used 2, jti 链 g0→g1→g2" {
  let system = system_init()
  assert_eq(run_command(Seed, system), Continue)
  assert_eq(run_command(Rotate, system), Continue)
  assert_eq(run_command(Rotate, system), Continue)
  assert_eq(system.generation, 2)
  assert_eq(system.current_jti, "g2")
  assert_true(system.prev_token is Some(_))
  let records = family_records(system)
  assert_eq(records.length(), 3)
  let mut used_count = 0
  for record in records {
    if record.used {
      used_count = used_count + 1
    }
  }
  assert_eq(used_count, 2)
}

///|
test "moongard 守恒律: ReplayOld 撤全族——族内 revoked 遍历真, 死后新票必 Revoked" {
  let system = system_init()
  assert_eq(run_command(Seed, system), Continue)
  assert_eq(run_command(Rotate, system), Continue)
  assert_eq(run_command(ReplayOld, system), Continue)
  assert_true(system.dead)
  for _jti, record in system.store.table {
    assert_true(record.revoked)
  }
  // 律③直探:死族后当前票(代际最新)再换发必 Err(Revoked)
  let verdict = @moongard.refresh(
    machine_config(),
    stub_signer(),
    system.store,
    MACHINE_NOW,
    system.current_token,
    "g-after-death",
  )
  match verdict {
    Err(Revoked(_claims)) => assert_true(true)
    _ => assert_true(false)
  }
}

///|
test "moongard 守恒律: Forge 伪造不动账——UnknownToken, 族谱零增删" {
  let system = system_init()
  assert_eq(run_command(Seed, system), Continue)
  let before = family_records(system).length()
  assert_eq(run_command(Forge, system), Continue)
  assert_eq(family_records(system).length(), before)
  assert_true(system.store.get("g-ghost") is None)
}

///|
test "moongard_family_conservation system: 模型像与系统账逐步同步" {
  // 双执行口径的首尾对账: 命令序列跑完, 模型 jti 链像 == 系统游标
  let mut model = model_empty()
  let system = system_init()
  let script = [Seed, Rotate, Rotate, ReplayOld]
  for command in script {
    let (_, expected) = model_execute(model, command)
    assert_eq(run_command(command, system), expected)
    model = transition(model, command, expected)
  }
  assert_eq(model.generation, system.generation)
  assert_eq(model.current_jti, system.current_jti)
  assert_eq(model.prev_jti, Some("g1"))
  assert_true(system.prev_token is Some(_))
  assert_eq(model.state, Dead)
}
