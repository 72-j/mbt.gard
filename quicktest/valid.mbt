// 默认实现"可运行但保守"；人工补充点以 TODO(P0)-TODO(P5) 标记
// 手维护实例（.hand-maintained 在案）:P0——ReplayOld 前置收紧（gen>=1，
// 无上代票即无可重放；业务面前置住业务面 TOML 注记，过滤在 valid 定点）。
// ========================================
// valid 是客户端契约：只有转移表声明的 (状态, 命令) 组合合法，
// 生成器据此避免非法命令序列（Deadlock 防护）

///|
/// 检查命令在当前模型状态下是否合法（源: [[transitions]]）
fn valid(model : Model, cmd : Command) -> Bool {
  match (model.state, cmd) {
    // Fresh
    (Fresh, Seed) => true
    // Alive
    (Alive, Rotate) => true
    (Alive, ReplayOld) => model.generation >= 1
    (Alive, Forge) => true
    // Dead
    (Dead, Forge) => true
    // 兜底: 未定义转移非法
    (_, _) => false
  }
}

///|
/// 前置条件（客户端契约, quickcheck_statemachine 接口形态）
fn precondition(model : Model, command : Command) -> @qcs.Logic {
  @qcs.Logic::predicate(name="valid transition", value=valid(model, command))
}

///|
test "moongard_family_conservation valid: 转移表白名单冒烟" {
  // 转移表白名单冒烟
  let model = model_empty()
  assert_true(valid(model, Seed))
  assert_false(valid(model, Rotate))
  let logic = precondition(model, Seed)
  assert_true(logic is @qcs.Logic::Predicate(..))
}
